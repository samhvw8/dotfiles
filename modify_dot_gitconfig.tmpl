#!/bin/sh
# Merge chezmoi-managed settings into an existing ~/.gitconfig instead of
# replacing it. Receives the current file contents on stdin (empty when the
# file does not exist) and writes the merged contents to stdout.
#
# ~/.gitconfig is the file `git config --global` writes to, so a plain
# overwrite would discard both pre-existing config and anything set after
# install -- on every single `chezmoi apply`, not just the first one.

set -eu

current="$(mktemp)"
trap 'rm -f "$current"' EXIT
cat >"$current"

# Without git we cannot merge safely, so never destroy what is already there.
if ! command -v git >/dev/null 2>&1; then
    if [ -s "$current" ]; then
        cat "$current"
    else
        printf '[user]\n\tname = %s\n\temail = %s\n\n[include]\n\tpath = ~/.base.gitconfig\n' \
            {{ .name | quote }} {{ .email | quote }}
    fi
    exit 0
fi

git config --file "$current" user.name {{ .name | quote }}
git config --file "$current" user.email {{ .email | quote }}

# Add the include exactly once, leaving any other includes untouched.
if ! git config --file "$current" --get-all include.path 2>/dev/null |
    grep -qx '~/.base.gitconfig'; then
    git config --file "$current" --add include.path '~/.base.gitconfig'
fi

cat "$current"
