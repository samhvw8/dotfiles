#!/bin/bash
# run_once_after_60-mise-install.sh.tmpl
# Install mise tools after chezmoi apply
#
# Runs after 10-install-dependencies.sh (which installs the mise binary) and
# 55-setup-mise-config.sh (which selects the full or minimal config). Because
# the correct config is already in place by now, this installs the right tool
# set in both modes -- no minimal-mode special case needed.

set -e

# 10-install-dependencies.sh may have just installed mise into ~/.local/bin.
# This is a separate process, so it does not inherit that script's PATH edit
# and ~/.local/bin is not yet on PATH on a fresh machine.
export PATH="$HOME/.local/bin:$PATH"

echo "📦 Installing mise tools..."

if command -v mise &> /dev/null; then
    mise install --yes
    echo "✅ Mise tools installed"
else
    echo "⚠️  Mise not found, skipping tool installation"
    echo "   Install mise first: curl https://mise.run | sh"
fi
