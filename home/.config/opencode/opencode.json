{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "instructions": [
    "{env:HOME}/.claude/rules/*.md",
    "{env:HOME}/.config/opencode/opencode-overlay.md"
  ],
  "small_model": "opencode-go/glm-5.3-flash",
  "permission": {
    "websearch": "deny"
  },
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.3"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "order": [
                "deepseek",
                "together",
                "fireworks"
              ],
              "only": [
                "deepseek",
                "together",
                "fireworks"
              ],
              "allow_fallbacks": true
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              "order": [
                "z-ai",
                "streamlake",
                "relace",
                "together",
                "fireworks"
              ],
              "only": [
                "z-ai",
                "streamlake",
                "relace",
                "together",
                "fireworks"
              ],
              "allow_fallbacks": true
            }
          }
        },
        "z-ai/glm-5.3": {
          "options": {
            "provider": {
              "order": [
                "z-ai",
                "gmicloud",
                "novita",
                "reka"
              ],
              "only": [
                "z-ai",
                "gmicloud",
                "novita",
                "reka"
              ],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/share/mise/shims/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "parallax": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/parallax",
        "mcp"
      ],
      "enabled": true
    }
  }
}
