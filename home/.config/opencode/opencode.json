{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3",
  "instructions": [
    "{env:HOME}/.claude/rules/*.md",
    "{env:HOME}/.config/opencode/opencode-overlay.md",
    "{env:HOME}/.config/opencode/output-style.md"
  ],
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/share/mise/shims/rea-agents",
        "mcp"
      ],
      "enabled": true
    }
  }
}
