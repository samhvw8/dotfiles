#!/usr/bin/env python3
"""tablefix: turn a Markdown pipe table into a table that pastes well elsewhere.

Input: stdin when it is a pipe or file, else the clipboard.
Output: the clipboard when run in a terminal (preview on stderr), else stdout.

Targets:
  notes  rich-text table (HTML + RTF) -> native table in Apple Notes, Pages,
         Mail, Google Docs, Notion, Word. Plain-text fallback is the box table.
  slack  box table inside a ``` code block (Slack messages have no tables).
  list   one block per row, for chat boxes (Messenger, Zalo, iMessage, Slack).
  box    box table without the code fence.
  md     clean, aligned Markdown table.

Examples:
  tablefix notes                       # clipboard -> clipboard, then paste in Notes
  tablefix slack --width 30            # wrap cells at 30 chars
  tablefix list --header "Field,Journals,Magazines"
  pbpaste | tablefix md > table.md
"""

import argparse
import html
import os
import stat
import re
import subprocess
import sys
import textwrap
import unicodedata



def split_row(line):
    line = line.strip()
    if line.startswith("|"):
        line = line[1:]
    if line.endswith("|") and not line.endswith("\\|"):
        line = line[:-1]
    cells = re.split(r"(?<!\\)\|", line)
    return [c.strip().replace("\\|", "|") for c in cells]


BOX_RULE = "=─━═┼┬┴├┤┌┐└┘╞╡╪╤╧╒╕╘╛╔╗╚╝╠╣╦╩╬┏┓┗┛┣┫┳┻╋┡┩╇+"
HEAVY_RULE = "═━="


def rule_kind(line):
    """'box' or 'md' for a rule/separator line, None for a data line."""
    s = line.strip()
    if not s or not set(s) <= set(BOX_RULE + "-:|│┃║ "):
        return None
    if set(s) & set(BOX_RULE):
        return "box"
    return "md" if "-" in s else None


def parse(text):
    """Read a Markdown pipe table or a box-drawing table (│ ├─┼─┤, +---+).

    Return (header or None, rows). Fails loudly when no table is found.
    In a box table the lines between two rules are one row, so cells
    wrapped over several lines are joined again.
    """
    lines = [l.replace("│", "|").replace("┃", "|").replace("║", "|") for l in text.splitlines()]
    boxed = any(rule_kind(l) == "box" for l in lines)
    rows, rules, group = [], {}, []

    def flush():
        if group:
            ncol = max(len(g) for g in group)
            rows.append([" ".join(g[i] for g in group if i < len(g) and g[i]) for i in range(ncol)])
            group.clear()

    for raw in lines:
        kind = rule_kind(raw)
        if kind:
            flush()
            rules[len(rows)] = rules.get(len(rows), False) or bool(set(raw) & set(HEAVY_RULE))
            continue
        if "|" not in raw:
            flush()
            continue
        cells = split_row(raw)
        if not any(cells):
            continue
        group.append(cells)
        if not boxed:
            flush()
    flush()
    if not rows:
        sys.exit("tablefix: no table rows ('|' or '│') found in input")
    ncol = max(len(r) for r in rows)
    rows = [r + [""] * (ncol - len(r)) for r in rows]
    # A header has its own rule after row 1 (or a heavy ═/━ one) and no other
    # rules between rows. Rules after every row mean there is no header.
    inner = {p for p in rules if 0 < p < len(rows)}
    header = rows.pop(0) if len(rows) > 1 and (inner == {1} or rules.get(1)) else None
    return header, rows


def width(s):
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 0 if unicodedata.combining(ch) else 1 for ch in s)


def pad(s, w):
    return s + " " * (w - width(s))


def wrap_cells(row, limit):
    if not limit:
        return [[c] for c in row]
    return [textwrap.wrap(c, limit, break_long_words=False) or [""] for c in row]


def box(header, rows, limit):
    all_rows = ([header] if header else []) + rows
    wrapped = [wrap_cells(r, limit) for r in all_rows]
    ncol = len(all_rows[0])
    widths = [max(width(line) for r in wrapped for line in r[i]) for i in range(ncol)]

    def rule(l, m, r, h="─"):
        return l + m.join(h * (w + 2) for w in widths) + r

    out = [rule("┌", "┬", "┐")]
    for n, cells in enumerate(wrapped):
        for k in range(max(len(c) for c in cells)):
            out.append("│" + "│".join(" " + pad(c[k] if k < len(c) else "", widths[i]) + " " for i, c in enumerate(cells)) + "│")
        if n < len(wrapped) - 1:
            out.append(rule("╞", "╪", "╡", "═") if header and n == 0 else rule("├", "┼", "┤"))
    out.append(rule("└", "┴", "┘"))
    return "\n".join(out)


def markdown(header, rows):
    head = header or [f"Column {i + 1}" for i in range(len(rows[0]))]
    widths = [max(width(r[i]) for r in [head] + rows) for i in range(len(head))]
    widths = [max(w, 3) for w in widths]
    line = lambda r: "| " + " | ".join(pad(c.replace("|", "\\|"), widths[i]) for i, c in enumerate(r)) + " |"
    return "\n".join([line(head), "| " + " | ".join("-" * w for w in widths) + " |"] + [line(r) for r in rows])


def as_list(header, rows, bold):
    blocks = []
    for r in rows:
        lines = [f"{bold}{r[0]}{bold}" if bold else r[0]]
        for i, c in enumerate(r[1:], 1):
            if c:
                lines.append(f"• {header[i]}: {c}" if header else f"• {c}")
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


def html_table(header, rows):
    td = lambda tag, c: f"<{tag} style=\"border:1px solid #999;padding:4px 8px;text-align:left;vertical-align:top\">{html.escape(c)}</{tag}>"
    parts = ['<table style="border-collapse:collapse">']
    if header:
        parts.append("<tr>" + "".join(td("th", c) for c in header) + "</tr>")
    parts += ["<tr>" + "".join(td("td", c) for c in r) + "</tr>" for r in rows]
    parts.append("</table>")
    return "<html><head><meta charset=\"utf-8\"></head><body>" + "".join(parts) + "</body></html>"


JXA = """
ObjC.import('AppKit');
function run(argv) {
  var pb = $.NSPasteboard.generalPasteboard;
  pb.clearContents;
  if (argv[1]) pb.setStringForType($(argv[1]), 'public.html');
  if (argv[2]) pb.setDataForType($.NSData.dataWithContentsOfFile($(argv[2])), 'public.rtf');
  pb.setStringForType($(argv[0]), 'public.utf8-plain-text');
}
"""


def copy(plain, rich_html=None):
    rtf_path = ""
    if rich_html:
        import tempfile
        rtf = subprocess.run(["textutil", "-stdin", "-format", "html", "-inputencoding", "UTF-8", "-convert", "rtf", "-stdout"],
                             input=rich_html.encode(), capture_output=True, check=True).stdout
        f = tempfile.NamedTemporaryFile(suffix=".rtf", delete=False)
        f.write(rtf)
        f.close()
        rtf_path = f.name
    subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA, plain, rich_html or "", rtf_path], check=True, capture_output=True)
    if rtf_path:
        os.unlink(rtf_path)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("target", nargs="?", default="notes", choices=["notes", "slack", "list", "box", "md"])
    p.add_argument("--header", help="comma-separated column names (overrides detection)")
    p.add_argument("--no-header", action="store_true", help="treat the first row as data")
    p.add_argument("--width", type=int, default=40, help="wrap box cells at N chars (0 = no wrap; default 40)")
    p.add_argument("--bold", default="*", help="bold marker for list titles: '*' Slack, '**' Markdown, '' none")
    p.add_argument("--stdout", action="store_true", help="print instead of copying to the clipboard")
    p.add_argument("--copy", action="store_true", help="copy to the clipboard even when stdout is not a terminal")
    a = p.parse_args()

    mode = os.fstat(sys.stdin.fileno()).st_mode
    piped = stat.S_ISFIFO(mode) or stat.S_ISREG(mode)
    text = sys.stdin.read() if piped else subprocess.run(["pbpaste"], capture_output=True, text=True, check=True).stdout
    header, rows = parse(text)
    if a.no_header and header:
        rows.insert(0, header)
        header = None
    if a.header:
        header = [h.strip() for h in a.header.split(",")]
        if len(header) != len(rows[0]):
            sys.exit(f"tablefix: --header has {len(header)} names but the table has {len(rows[0])} columns")

    rich = None
    if a.target == "notes":
        out, rich = box(header, rows, a.width), html_table(header, rows)
    elif a.target == "slack":
        out = "```\n" + box(header, rows, a.width) + "\n```"
    elif a.target == "box":
        out = box(header, rows, a.width)
    elif a.target == "list":
        out = as_list(header, rows, a.bold)
    else:
        out = markdown(header, rows)

    if a.stdout or not (a.copy or sys.stdout.isatty()):
        print(out)
        return
    copy(out, rich)
    print(out, file=sys.stderr)
    kind = "rich-text table" if rich else a.target
    print(f"\ntablefix: copied {len(rows)} rows as {kind}. Paste with ⌘V.", file=sys.stderr)


if __name__ == "__main__":
    main()
