#!/bin/sh
# agent-ops is a thin wrapper over harness-ops (~/workspace/tools/termctl).
# Same subcommands: ls, send, which, read, name, whoami. Plus msg, slash, clear,
# wait-idle and spawn. See SKILL.md.
for c in harness-ops "$HOME/.local/bin/harness-ops"; do
  if command -v "$c" >/dev/null 2>&1; then
    exec "$c" "$@"
  fi
done
echo "agent-ops: harness-ops not found. Install it: cd ~/workspace/tools/termctl && mise run install" >&2
exit 1
