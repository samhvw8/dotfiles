{
  "advisorModel": "fable",
  "autoMode": {
    "environment": [
      "$defaults",
      "**Key internal services**: the user's self-hosted artifact server at artifacts.3cxo.work (content at *.art.3cxo.work), used through the artifact-server MCP. Uploading with art-put (~/.local/bin/art-put, which reads the MCP token itself and sends only to artifacts.3cxo.work) is the routine publish step, not credential exfiltration",
      "**Org-specific CLIs**: routine personal tooling — mise (tool versions and tasks), ccp (Claude profile manager), codegraph, lark-cli, art-put"
    ]
  },
  "enabledPlugins": {
    "code-modernization@claude-plugins-official": true,
    "image-view@claude-image-view": true,
    "prismantis@prismantis": true,
    "prompt-rail@oikon48": true
  },
  "env": {
    "MEDIASIFT_ON": "me.ubuntu.home"
  },
  "extraKnownMarketplaces": {
    "claude-image-view": {
      "source": {
        "repo": "jarrodwatts/claude-image-view",
        "source": "github"
      }
    },
    "oikon48": {
      "source": {
        "repo": "oikon48/prompt-rail",
        "source": "github"
      }
    },
    "prismantis": {
      "source": {
        "repo": "NahumLitvin/prismantis",
        "source": "github"
      }
    }
  },
  "inputNeededNotifEnabled": true,
  "model": "fable",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "STE Lite",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(source:*)",
      "Bash(tail:*)",
      "Read(~/.zshrc)",
      "WebFetch(domain:*)",
      "WebSearch",
      "Write",
      "mcp__claude_ai_Parallax",
      "mcp__codegraph",
      "mcp__lark",
      "mcp__lark-1hub",
      "Bash(codegraph:*)",
      "Bash(lark-cli:*)",
      "Bash(art-put:*)"
    ],
    "defaultMode": "auto"
  },
  "pluginConfigs": {
    "prismantis@prismantis": {
      "options": {
        "theme": "dracula"
      }
    },
    "prompt-rail@oikon48": {
      "options": {
        "mode": "vertical"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": true,
  "theme": "dark",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "worktree": {
    "baseRef": "head"
  }
}
